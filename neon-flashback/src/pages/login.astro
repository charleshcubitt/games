---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Log in</title>
		<style>
			:root {
				--green: #4dff88;
				--green-glow: #33ff66;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				background: #000;
			}
			body {
				font-family: 'Courier New', monospace;
				min-height: 100vh;
				position: relative;
				isolation: isolate;
				color: #ddd;
			}
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background: radial-gradient(ellipse at center, #0c0c0c 0%, #000 100%);
			}
			body::after {
				content: '';
				position: fixed;
				inset: 0;
				z-index: -1;
				background: repeating-linear-gradient(
					to bottom,
					rgba(0, 0, 0, 0) 0px,
					rgba(0, 0, 0, 0) 1px,
					rgba(0, 40, 10, 0.12) 2px,
					rgba(0, 40, 10, 0.12) 3px
				);
			}
			.wrap {
				max-width: 24rem;
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			.site-title {
				text-align: center;
				font-weight: bold;
				font-size: clamp(1.6rem, 7vw, 2.2rem);
				letter-spacing: 0.3em;
				margin: 0 0 2rem;
				color: var(--green);
				text-shadow:
					0 0 10px var(--green-glow),
					0 0 22px rgba(51, 255, 102, 0.6);
			}
			.site-title a {
				color: inherit;
				text-decoration: none;
			}
			h1 {
				font-size: 1.4rem;
				letter-spacing: 0.15em;
				color: #eee;
			}
			form {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
				margin-top: 1rem;
			}
			input {
				padding: 0.6rem;
				font-size: 1rem;
				font-family: inherit;
				background: #000;
				border: 1px solid rgba(77, 255, 136, 0.4);
				border-radius: 0.3rem;
				color: #eee;
			}
			input:focus {
				outline: none;
				border-color: var(--green);
				box-shadow: 0 0 8px rgba(51, 255, 102, 0.5);
			}
			button {
				padding: 0.6rem;
				font-size: 1rem;
				font-family: inherit;
				cursor: pointer;
				background: none;
				border: 1px solid rgba(77, 255, 136, 0.5);
				border-radius: 0.3rem;
				color: var(--green);
				text-shadow: 0 0 6px rgba(51, 255, 102, 0.6);
			}
			button:hover {
				border-color: var(--green);
				box-shadow: 0 0 10px rgba(51, 255, 102, 0.5);
			}
			#submit {
				background: rgba(77, 255, 136, 0.08);
			}
			.error {
				color: #ff6b6b;
				font-size: 0.9rem;
			}
			.switch {
				margin-top: 1rem;
				font-size: 0.9rem;
			}
			.switch button {
				background: none;
				border: none;
				color: var(--green);
				text-decoration: underline;
				cursor: pointer;
				padding: 0;
				font-size: inherit;
				text-shadow: none;
			}
			.session {
				display: none;
			}
			#voucher-toggle {
				background: none;
				border: none;
				color: var(--green);
				text-decoration: underline;
				cursor: pointer;
				padding: 0;
				font-size: 0.9rem;
				margin-top: 0.5rem;
				text-shadow: none;
			}
			#voucher-field {
				display: none;
			}
			.ok {
				color: var(--green);
				font-size: 0.9rem;
				text-shadow: 0 0 6px rgba(51, 255, 102, 0.5);
			}
			a {
				color: var(--green);
			}
		</style>
	</head>
	<body>
		<div class="wrap">
		<p class="site-title"><a href="/">RETRO GAMES</a></p>
		<div id="signed-out">
			<h1 id="mode-heading">Log in</h1>
			<form id="auth-form">
				<input id="name" type="text" placeholder="Name" style="display: none" autocomplete="name" />
				<input id="email" type="email" placeholder="Email" required autocomplete="email" />
				<input id="password" type="password" placeholder="Password" required autocomplete="current-password" />
				<button id="voucher-toggle" type="button">Have a voucher code?</button>
				<div id="voucher-field">
					<input id="voucher-code" type="text" placeholder="Voucher code (1 week free access)" autocomplete="off" />
				</div>
				<button id="submit" type="submit">Log in</button>
				<p id="error" class="error"></p>
			</form>
			<p class="switch">
				<span id="switch-prompt">Don't have an account?</span>
				<button id="switch-mode" type="button">Sign up</button>
			</p>
		</div>

		<div id="signed-in" class="session">
			<h1>You're logged in</h1>
			<p id="who"></p>
			<p id="voucher-result"></p>
			<p><a href="/">Go to games</a></p>
			<button id="sign-out" type="button">Sign out</button>
		</div>
		</div>

		<script>
			import { authClient } from '../lib/auth';

			const signedOutEl = document.getElementById('signed-out')!;
			const signedInEl = document.getElementById('signed-in')!;
			const whoEl = document.getElementById('who')!;
			const form = document.getElementById('auth-form') as HTMLFormElement;
			const nameInput = document.getElementById('name') as HTMLInputElement;
			const emailInput = document.getElementById('email') as HTMLInputElement;
			const passwordInput = document.getElementById('password') as HTMLInputElement;
			const submitBtn = document.getElementById('submit')!;
			const errorEl = document.getElementById('error')!;
			const modeHeading = document.getElementById('mode-heading')!;
			const switchPrompt = document.getElementById('switch-prompt')!;
			const switchModeBtn = document.getElementById('switch-mode')!;
			const voucherToggle = document.getElementById('voucher-toggle')!;
			const voucherField = document.getElementById('voucher-field')!;
			const voucherCodeInput = document.getElementById('voucher-code') as HTMLInputElement;
			const voucherResultEl = document.getElementById('voucher-result')!;

			voucherToggle.addEventListener('click', () => {
				const showing = voucherField.style.display === 'block';
				voucherField.style.display = showing ? 'none' : 'block';
				voucherToggle.textContent = showing ? 'Have a voucher code?' : 'Hide voucher code';
				if (!showing) voucherCodeInput.focus();
			});

			let mode: 'signin' | 'signup' = 'signin';

			function applyMode() {
				const isSignUp = mode === 'signup';
				nameInput.style.display = isSignUp ? '' : 'none';
				nameInput.required = isSignUp;
				modeHeading.textContent = isSignUp ? 'Sign up' : 'Log in';
				submitBtn.textContent = isSignUp ? 'Sign up' : 'Log in';
				switchPrompt.textContent = isSignUp ? 'Already have an account?' : "Don't have an account?";
				switchModeBtn.textContent = isSignUp ? 'Log in' : 'Sign up';
				errorEl.textContent = '';
			}

			switchModeBtn.addEventListener('click', () => {
				mode = mode === 'signin' ? 'signup' : 'signin';
				applyMode();
			});

			function showSignedIn(email: string) {
				signedOutEl.style.display = 'none';
				signedInEl.style.display = 'block';
				whoEl.textContent = `Signed in as ${email}.`;
			}

			function showSignedOut() {
				signedOutEl.style.display = 'block';
				signedInEl.style.display = 'none';
				voucherResultEl.textContent = '';
			}

			async function redeemVoucherIfEntered() {
				const code = voucherCodeInput.value.trim();
				if (!code) return;

				const session = await authClient.getSession();
				const token = session.data?.session?.token;
				if (!token) return;

				const res = await fetch('/api/redeem-voucher', {
					method: 'POST',
					headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
					body: JSON.stringify({ code }),
				});
				const data = await res.json();
				if (res.ok) {
					voucherResultEl.textContent = 'Voucher redeemed -- you have access!';
					voucherResultEl.className = 'ok';
				} else {
					voucherResultEl.textContent = data.error ?? 'Could not redeem that voucher code.';
					voucherResultEl.className = 'error';
				}
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				errorEl.textContent = '';
				try {
					if (mode === 'signup') {
						const { error } = await authClient.signUp.email({
							name: nameInput.value,
							email: emailInput.value,
							password: passwordInput.value,
						});
						if (error) throw error;
					} else {
						const { error } = await authClient.signIn.email({
							email: emailInput.value,
							password: passwordInput.value,
						});
						if (error) throw error;
					}
					const session = await authClient.getSession();
					if (session.data?.user?.email) {
						showSignedIn(session.data.user.email);
						await redeemVoucherIfEntered();
					}
				} catch (err: any) {
					errorEl.textContent = err?.message ?? String(err);
				}
			});

			document.getElementById('sign-out')!.addEventListener('click', async () => {
				await authClient.signOut();
				showSignedOut();
				form.reset();
				mode = 'signin';
				applyMode();
				voucherField.style.display = 'none';
				voucherToggle.textContent = 'Have a voucher code?';
			});

			applyMode();
			authClient.getSession().then((session) => {
				if (session.data?.user?.email) {
					showSignedIn(session.data.user.email);
				}
			});
		</script>
	</body>
</html>
